{
  "type": "object",
  "properties": {
    "api_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "operation": {
      "enum": [
        "status",
        "doctor",
        "scan",
        "preview",
        "configure",
        "rules.set",
        "apply",
        "automation.set",
        "revert",
        "profiles.list",
        "profiles.save",
        "profiles.delete",
        "theme.follow",
        "theme.sync"
      ]
    },
    "arguments": {
      "type": "object"
    }
  },
  "required": [
    "api_version",
    "request_id",
    "operation",
    "arguments"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:icon-normalizer:request:v1",
  "title": "Icon Normalizer v1 request (additive operations in backend 3.1)",
  "$defs": {
    "patch": {
      "type": "object",
      "properties": {
        "target": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.98
        },
        "deadband": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "inner": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 0.95
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reset": {
              "const": true
            }
          },
          "required": [
            "reset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "skip": {
              "type": "boolean"
            },
            "classification": {
              "enum": [
                "auto",
                "plate-rect",
                "plate-circle",
                "artwork",
                "glyph"
              ]
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "skip",
            "classification"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "classification": {
                    "const": "auto"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "source_sha256"
                  ]
                }
              },
              "else": {
                "required": [
                  "source_sha256"
                ]
              }
            }
          ]
        }
      ]
    },
    "status": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "doctor": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "scan": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "preview": {
      "type": "object",
      "properties": {
        "icon_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "enum": [
            16,
            24,
            32,
            48,
            64,
            96,
            128,
            256,
            512
          ]
        },
        "draft": {
          "$ref": "#/$defs/patch"
        }
      },
      "required": [
        "icon_id",
        "source_sha256",
        "size"
      ],
      "additionalProperties": false
    },
    "configure": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patch": {
          "$ref": "#/$defs/patch"
        }
      },
      "required": [
        "expected_revision",
        "patch"
      ],
      "additionalProperties": false
    },
    "rules.set": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "icon_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "expected_revision",
        "icon_id",
        "rule"
      ],
      "additionalProperties": false
    },
    "apply": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "activate": {
          "type": "boolean"
        }
      },
      "required": [
        "expected_revision",
        "activate"
      ],
      "additionalProperties": false
    },
    "automation.set": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "revert": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "profiles.list": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "theme.sync": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "theme.follow": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "profile_parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.98
        },
        "deadband": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "inner": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 0.95
        }
      },
      "required": [
        "target",
        "deadband",
        "inner"
      ],
      "additionalProperties": false,
      "minProperties": 1
    },
    "profiles.save": {
      "type": "object",
      "properties": {
        "expected_profiles_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "NFC-normalized and trimmed name: 1..64 printable characters, enforced by backend."
        },
        "parameters": {
          "$ref": "#/$defs/profile_parameters"
        }
      },
      "required": [
        "expected_profiles_revision",
        "name",
        "parameters"
      ],
      "additionalProperties": false
    },
    "profiles.delete": {
      "type": "object",
      "properties": {
        "expected_profiles_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "expected_profiles_revision",
        "profile_id"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "status"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "doctor"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/doctor"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "scan"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/scan"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "preview"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/preview"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "configure"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/configure"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "rules.set"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/rules.set"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "apply"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/apply"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "automation.set"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/automation.set"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "revert"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/revert"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "profiles.list"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/profiles.list"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "profiles.save"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/profiles.save"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "profiles.delete"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/profiles.delete"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "theme.follow"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/theme.follow"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "theme.sync"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/theme.sync"
          }
        }
      }
    }
  ]
}
