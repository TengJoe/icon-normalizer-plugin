[Unit]
Description=Normalize icons when installed application launchers change

[Path]
# Newly installed applications normalize within seconds of their launcher
# landing; the timer unit remains as the fallback for vendor hot-updates.
PathChanged=@HOME@/.local/share/applications
PathChanged=/usr/share/applications
PathChanged=/var/lib/flatpak/exports/share/applications
Unit=icon-normalizer.service

[Install]
WantedBy=default.target
